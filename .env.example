# Copy this file to ".env" (in the project root) and fill in YOUR values.
# NEVER commit the real .env file.
PORT=5000
NODE_ENV=development
DB_HOST=localhost
DB_PORT=3306
DB_NAME=college_management
DB_USER=root
DB_PASSWORD=your_password
# Make this a long random string (32+ characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_secret
# Normal login lasts 1 hour; "Remember me" lasts 7 days
JWT_EXPIRES_IN=1h
JWT_REMEMBER_EXPIRES_IN=7d
# Rate limits per IP address per 15 minutes. Keep these defaults for real use.
# Only raise them temporarily to run "npm run verify" (for example API_RATE_LIMIT=2000 and LOGIN_RATE_LIMIT=200).
API_RATE_LIMIT=300
LOGIN_RATE_LIMIT=10
CLIENT_URL=http://localhost:5173
# Shown on receipts, hall tickets and grade cards
COLLEGE_NAME=Greenfield Institute of Technology
